# Local demonstration values only; no real credentials.
MYSQL_DATABASE=material_studio
MYSQL_USER=studio
MYSQL_PASSWORD=local-demo-password
MYSQL_ROOT_PASSWORD=local-demo-root
WEB_PORT=3000
# Set true when the public site uses HTTPS.
COOKIE_SECURE=false
# Optional public origin when running behind an HTTPS reverse proxy.
APP_ORIGIN=
# Positive admission limits, independent of the in-memory execution queue.
STUDIO_MAX_PENDING=100
STUDIO_MAX_PENDING_PER_USER=20
STUDIO_SUBMISSIONS_PER_MINUTE=10
